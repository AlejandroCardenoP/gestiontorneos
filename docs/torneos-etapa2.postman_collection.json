{
  "info": {
    "name": "Gestion de torneos — segunda entrega",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden sobre una base de pruebas. Crea y conserva un torneo finalizado como evidencia. No elimina registros previos."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:9090/apiinicial"
    }
  ],
  "item": [
    {
      "name": "01 Crear deporte de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/deportes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Demo {{runId}}\",\n  \"minJugadores\": 5,\n  \"maxJugadores\": 11\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"deporteId\", pm.response.json().id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString());"
            ]
          }
        }
      ]
    },
